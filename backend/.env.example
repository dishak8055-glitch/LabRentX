# Local development defaults. Replace all placeholder values before production.
SECRET_KEY=replace-this-development-key-before-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=False

# Local SQLite is the no-setup fallback. For production, select mysql and provide
# the database connection values using your hosting provider's secret manager.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Production example (set these in the host, never commit credentials):
# DEBUG=False
# SECRET_KEY=<generate-a-long-random-secret>
# ALLOWED_HOSTS=<your-backend-hostname>
# CORS_ALLOWED_ORIGINS=<your-frontend-origin>
# SECURE_SSL_REDIRECT=True
# DB_ENGINE=mysql
# DB_NAME=<database-name>
# DB_USER=<database-user>
# DB_PASSWORD=<database-password>
# DB_HOST=<database-host>
# DB_PORT=3306
